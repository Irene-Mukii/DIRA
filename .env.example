# Local development defaults only. Never use example values as production credentials.
DATABASE_URL=postgresql://dira_dev:dira_local_dev_only@localhost:5433/dira_dev
DIRA_TEST_DATABASE_URL=
DIRA_DEMO_MODE=true

# Local-only synthetic-data importer target. Never add these staging credentials to Vercel.
DIRA_STAGING_PROJECT_REF=
DIRA_STAGING_DATABASE_URL=

# Keeper calendar MCP endpoint. OAuth must be provided by the server-side user session.
KEEPER_MCP_URL=https://www.keeper.sh/mcp

# Dira MCP endpoint and server-side demo access token.
DIRA_MCP_SERVER_URL=http://localhost:3000/api/mcp/server
DIRA_MCP_ACCESS_TOKEN=

# Optional education-page retrieval via the pinned Fetch MCP server.
# Local default uses stdio/uvx. Use HTTP for the authenticated Render gateway from Vercel.
FETCH_MCP_ENABLED=false
FETCH_MCP_TRANSPORT=stdio
# Optional stdio executable override; defaults to `uvx`.
FETCH_MCP_COMMAND=
# Required only when FETCH_MCP_TRANSPORT=http. Set only in Vercel server-side environment.
FETCH_MCP_URL=
FETCH_MCP_TOKEN=

# Z.AI GLM-5.3 agent credential. The model and official endpoint are fixed in server code.
ZAI_API_KEY=

# Outbound-call settings. Keep the destination in ignored .env.local only.
# Demo mode (true) dials ONLY the demo number below and skips teacher phone/consent checks.
# Real mode (anything else) dials the teacher's stored phone and requires stored consent.
# DIRA_VOICE_DEMO_MODE / DIRA_VOICE_DEMO_TO are accepted as aliases for these two.
DIRA_DEMO_CALL_TEST_MODE=false
DIRA_DEMO_CALL_TO=
# Production-only opt-in for the operator-secret-protected demo voice endpoint.
# Requires DIRA_DEMO_MODE=true and DIRA_DEMO_CALL_TEST_MODE=true; never enables real-teacher calls.
DIRA_ALLOW_PRODUCTION_DEMO_CALLS=false
# Public, on-demand visitor calls are separately opt-in and strictly rate-limited.
DIRA_ALLOW_PUBLIC_DEMO_CALLS=false
DEMO_CALL_RATE_LIMIT_SECRET=

# Protects the server-side follow-up queue, dispatch and recording-worker triggers.
FOLLOW_UP_SCHEDULER_SECRET=

# Africa's Talking VOICE (production, https://voice.africastalking.com/call). Server-side only.
# AFRICASTALKING_VOICE_FROM is the caller ID only (E.164, never a URL).
# Voice never reads the SMS variables. SMS credentials (AFRICASTALKING_USERNAME_SMS /
# AFRICASTALKING_API_KEY_SMS) belong to the separate SMS sandbox setup and are untouched here.
AFRICASTALKING_USERNAME_VOICE=
AFRICASTALKING_API_KEY_VOICE=
AFRICASTALKING_VOICE_FROM=

# Callback security. Africa's Talking does not sign callbacks, so the secret is part of the URL PATH
# (the dashboard rejected ?token=). Use a long random value with letters/digits only, e.g.
# `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`.
# Dashboard voice callback:  <DIRA_PUBLIC_BASE_URL>/api/voice/cb/<VOICE_CALLBACK_SECRET>/teacher-follow-up
# Dashboard events callback (only if your account offers one, optional):
#                            <DIRA_PUBLIC_BASE_URL>/api/voice/cb/<VOICE_CALLBACK_SECRET>/events
# The recording callback is generated automatically inside the call instructions.
# Keep this independent from FOLLOW_UP_SCHEDULER_SECRET.
VOICE_CALLBACK_SECRET=
# Public origin only (no path, no token), e.g. the current ngrok https origin. Replaces the old
# AFRICASTALKING_CALL_BACK_URL. If unset it is derived from forwarded request headers.
DIRA_PUBLIC_BASE_URL=
# Optional extra hosts recordings may be downloaded from (comma separated); *.africastalking.com is built in.
VOICE_RECORDING_ALLOWED_HOSTS=

# MVP transcription sends completed call recordings to OpenAI's Audio Transcriptions API.
# This is a temporary security exception: before go-live replace it with a security-reviewed,
# self-hosted open-weight transcription model so learner audio remains in DIRA-controlled systems.
OPENAI_API_KEY=
# Optional; defaults to gpt-transcribe.
OPENAI_STT_MODEL=

# Local development only. These public demo defaults are not production secrets.
DATABASE_URL=postgresql://dira_dev:dira_local_dev_only@localhost:5433/dira_dev
DIRA_DEMO_SCHOOL_ID=SCH001
DIRA_DEMO_TEACHER_ID=T001

# Keeper calendar MCP endpoint. OAuth must be provided by the server-side user session.
KEEPER_MCP_URL=https://www.keeper.sh/mcp

# Outbound-call test settings. Keep the destination in ignored .env.local only.
DIRA_DEMO_CALL_TEST_MODE=false
DIRA_DEMO_CALL_TO=

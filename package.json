{
  "name": "dira",
  "version": "1.0.0",
  "description": "Teacher-focused classroom observation and learning pathway system",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:seed:dev": "node scripts/seed-development.cjs --confirm-development",
    "test:follow-ups": "vitest run",
    "test:suggest-test": "vitest run --config vitest.unit.config.mjs",
    "mcp:server": "tsx scripts/mcp-server.ts",
    "mcp:test": "tsx scripts/test-mcp-client.ts",
    "follow-up:queue": "node --env-file=.env.local scripts/trigger-follow-up.cjs queue",
    "follow-up:dispatch": "node --env-file=.env.local scripts/trigger-follow-up.cjs dispatch",
    "follow-up:recordings": "node --env-file=.env.local scripts/trigger-follow-up.cjs recordings"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^18.0.7",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "vitest": "^3.2.7"
  }
}
